
<!DOCTYPE html>
<html>
<head>
    <title>Calculadora de Orçamento para Salão</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            text-align: center;
            margin: 50px;
            background: #f9f9f9;
            color: black;
        }
        .calculator {
            max-width: 400px;
            margin: auto;
            padding: 20px;
            border: 1px solid #ccc;
            border-radius: 10px;
            background-color: #ffffff;
        }
        .calculator label {
            display: block;
            margin: 10px 0 5px;
        }
        .calculator input, .calculator select {
            width: 100%;
            padding: 8px;
            margin: 5px 0 15px;
            border: 1px solid #ccc;
            border-radius: 5px;
        }
        .calculator button {
            background-color: #4CAF50;
            color: white;
            border: none;
            padding: 10px 20px;
            cursor: pointer;
            border-radius: 5px;
        }
        .calculator button:hover {
            background-color: #45a049;
        }
        .result {
            margin-top: 20px;
            font-size: 1.2em;
            color: black;
        }
    </style>
</head>
<body>
    <div class="calculator">
        <h2>Calculadora de Orçamento para Salão</h2>

        <label for="nivel">Escolha o Nível do Orçamento:</label>
        <select id="nivel">
            <option value="economico">Econômico</option>
            <option value="intermedio">Intermédio</option>
            <option value="premium">Premium</option>
        </select>

        <label for="cadeiras">Número de Cadeiras de Cabeleireiro:</label>
        <input type="number" id="cadeiras" placeholder="Ex.: 5" />

        <label for="lavatórios">Número de Lavatórios:</label>
        <input type="number" id="lavatórios" placeholder="Ex.: 2" />

        <label for="rececoes">Itens para Recepção:</label>
        <input type="number" id="rececoes" placeholder="Ex.: 1" />

        <button onclick="calcularOrcamento()">Calcular Orçamento</button>

        <div class="result" id="resultado"></div>
    </div>

    <script>
        function calcularOrcamento() {
            // Preços baseados nos níveis
            const niveis = {
                economico: { cadeiras: 400, lavatorios: 500, rececoes: 300 },
                intermedio: { cadeiras: 1000, lavatorios: 1750, rececoes: 1150 },
                premium: { cadeiras: 1600, lavatorios: 3000, rececoes: 2000 }
            };

            // Obter o nível escolhido
            const nivel = document.getElementById("nivel").value;
            const precos = niveis[nivel];

            // Obter os valores inseridos pelo usuário
            const cadeiras = document.getElementById("cadeiras").value || 0;
            const lavatorios = document.getElementById("lavatórios").value || 0;
            const rececoes = document.getElementById("rececoes").value || 0;

            // Cálculo do total
            const total = (cadeiras * precos.cadeiras) +
                          (lavatorios * precos.lavatorios) +
                          (rececoes * precos.rececoes);

            // Exibir o resultado
            document.getElementById("resultado").innerText = `O orçamento estimado (${nivel}) é de €${total.toFixed(2)}.`;
        }
    </script>
</body>
</html>
